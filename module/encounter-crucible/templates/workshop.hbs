<form class="ec-shell ec-workshop-form">
  <header class="ec-toolbar">
    <div>
      <h1>{{localize "EC.Workshop.Title"}}</h1>
      <p>{{localize "EC.Workshop.Subtitle"}}</p>
    </div>
    {{#if generated}}
      <button type="button" data-action="ec-open-dashboard"><i class="fa-solid fa-chart-simple"></i> {{localize "EC.Action.Dashboard"}}</button>
    {{/if}}
  </header>

  <section class="ec-config-grid">
    <fieldset>
      <legend>{{localize "EC.Workshop.Identity"}}</legend>
      <label>{{localize "EC.Field.Name"}}<input type="text" name="name" value="{{name}}" placeholder="{{localize "EC.Workshop.DefaultName"}}"></label>
      <label>{{localize "EC.Field.Theme"}}<input type="text" name="theme" value="{{theme}}" placeholder="Generated"></label>
      <label>{{localize "EC.Field.Target"}}
        <select name="target">
          {{#each targetOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
    </fieldset>

    <fieldset>
      <legend>{{localize "EC.Workshop.Source"}}</legend>
      <label>{{localize "EC.Field.FolderFilter"}}<input type="search" name="folderSearch" value="{{folderSearch}}" placeholder="{{localize "EC.Workshop.FolderFilterPlaceholder"}}"></label>
      <label>{{localize "EC.Field.ActorFolder"}}
        <select name="folderId">
          <option value="">{{localize "EC.Workshop.AllWorldNpcs"}}</option>
          {{#each folders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </label>
      <label class="ec-checkbox"><input type="checkbox" name="recursive" {{#if recursive}}checked{{/if}}> {{localize "EC.Field.Recursive"}}</label>
      <div class="ec-filter-actions">
        <button type="button" data-action="ec-apply-filters"><i class="fa-solid fa-filter"></i> {{localize "EC.Action.ApplyFilters"}}</button>
        <button type="button" data-action="ec-clear-filters"><i class="fa-solid fa-filter-circle-xmark"></i> {{localize "EC.Action.ClearFilters"}}</button>
      </div>
      <p>{{localize "EC.Workshop.CandidateHint"}}</p>
    </fieldset>

    <fieldset>
      <legend>{{localize "EC.Workshop.Composition"}}</legend>
      <label class="ec-checkbox"><input type="checkbox" name="preferQuantity" {{#if preferQuantity}}checked{{/if}}> {{localize "EC.Field.PreferQuantity"}}</label>
      <label class="ec-checkbox"><input type="checkbox" name="preferStrength" {{#if preferStrength}}checked{{/if}}> {{localize "EC.Field.PreferStrength"}}</label>
      <label class="ec-checkbox"><input type="checkbox" name="allowDuplicates" {{#if allowDuplicates}}checked{{/if}}> {{localize "EC.Field.AllowDuplicates"}}</label>
      <label class="ec-checkbox"><input type="checkbox" name="boss" {{#if boss}}checked{{/if}}> {{localize "EC.Field.Boss"}}</label>
      <label class="ec-checkbox"><input type="checkbox" name="includeMinions" {{#if includeMinions}}checked{{/if}}> {{localize "EC.Field.Minions"}}</label>
      <label>{{localize "EC.Field.FixedGroupSize"}}<input type="number" name="fixedGroupSize" min="0" max="30" value="{{fixedGroupSize}}"></label>
      <div class="ec-inline-fields">
        <label>{{localize "EC.Field.MinimumCount"}}<input type="number" name="minimumCount" min="1" max="30" value="{{minimumCount}}"></label>
        <label>{{localize "EC.Field.MaximumCount"}}<input type="number" name="maximumCount" min="1" max="30" value="{{maximumCount}}"></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize "EC.Workshop.TacticalConditions"}}</legend>
      <div class="ec-condition-grid">
        {{#each tacticalConditions}}
          <label class="ec-checkbox"><input type="checkbox" name="condition" value="{{id}}" {{#if selected}}checked{{/if}}> {{label}}</label>
        {{/each}}
      </div>
    </fieldset>
  </section>

  <section>
    <h2>{{localize "EC.Side.Party"}}</h2>
    <div class="ec-chip-list">
      {{#each party}}<span class="ec-chip">{{name}} · L{{level}}</span>{{/each}}
    </div>
  </section>

  <section>
    <h2>{{localize "EC.Workshop.Candidates"}}</h2>
    <div class="ec-candidate-toolbar">
      <label>{{localize "EC.Field.CandidateFilter"}}<input type="search" name="candidateSearch" value="{{candidateSearch}}" placeholder="{{localize "EC.Workshop.CandidateFilterPlaceholder"}}"></label>
      <p>{{localize "EC.Workshop.CandidateCount"}}: {{matchingCandidateCount}} / {{candidateCount}} · {{localize "EC.Workshop.SelectedCount"}}: {{selectedCandidateCount}}</p>
    </div>
    {{#if candidateLimitReached}}
      <p class="ec-limit-notice">{{localize "EC.Workshop.CandidateLimitNotice"}} {{candidateLimit}}.</p>
    {{/if}}
    <div class="ec-candidate-list">
      {{#each candidates}}
        <label class="ec-candidate">
          <input type="hidden" name="visibleCandidate" value="{{actorUuid}}">
          <input type="checkbox" name="candidate" value="{{actorUuid}}" {{#if selected}}checked{{/if}}>
          <span>{{name}}</span><small>CR {{crText}} · {{xp}} XP</small>
        </label>
      {{else}}
        <p>{{localize "EC.Workshop.NoCandidates"}}</p>
      {{/each}}
    </div>
  </section>

  <div class="ec-primary-action">
    {{#if generating}}
      <div class="ec-generation-status" role="status" aria-live="polite">
        <progress data-ec-generation-progress max="{{generationProgress.maximumDepth}}" value="{{generationProgress.depth}}"></progress>
        <span data-ec-generation-status>{{localize "EC.Workshop.GenerationStarting"}}</span>
      </div>
      <button type="button" data-action="ec-cancel-generation"><i class="fa-solid fa-ban"></i> {{localize "EC.Action.Cancel"}}</button>
    {{else}}
      <button type="submit"><i class="fa-solid fa-fire"></i> {{localize "EC.Action.Generate"}}</button>
    {{/if}}
  </div>

  {{#if generated}}
    <section class="ec-generated">
      <h2>{{generated.name}}</h2>
      <p><strong>{{localize "EC.Dashboard.Overall"}}:</strong> {{generatedAssessment.classification}} · {{generatedAssessment.volatility.id}} {{localize "EC.Tracker.Volatility"}}</p>
      <div class="ec-table-scroll">
        <table>
          <thead><tr><th>{{localize "EC.Field.Name"}}</th><th>{{localize "EC.Field.Quantity"}}</th><th>{{localize "EC.Field.CR"}}</th><th>XP</th></tr></thead>
          <tbody>{{#each generatedEnemies}}<tr><td>{{name}}</td><td>{{quantity}}</td><td>{{cr}}</td><td>{{xp}}</td></tr>{{/each}}</tbody>
        </table>
      </div>
      <footer class="ec-footer-actions">
        <button type="button" data-action="ec-save"><i class="fa-solid fa-book"></i> {{localize "EC.Action.Save"}}</button>
        <button type="button" data-action="ec-place"><i class="fa-solid fa-location-dot"></i> {{localize "EC.Action.Place"}}</button>
        <button type="button" data-action="ec-create-combat"><i class="fa-solid fa-swords"></i> {{localize "EC.Action.CreateCombat"}}</button>
        <button type="button" data-action="ec-open-dashboard"><i class="fa-solid fa-chart-simple"></i> {{localize "EC.Action.Dashboard"}}</button>
      </footer>
    </section>
  {{/if}}
</form>
