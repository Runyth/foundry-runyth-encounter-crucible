<div class="ec-shell">
  <header class="ec-toolbar">
    <div>
      <h1>{{encounterName}}</h1>
      <p>{{localize "EC.Dashboard.Theme"}}: {{theme}}</p>
    </div>
    <div class="ec-actions">
      <button type="button" data-action="ec-refresh"><i class="fa-solid fa-rotate"></i> {{localize "EC.Action.Refresh"}}</button>
      <button type="button" data-action="ec-open-workshop"><i class="fa-solid fa-hammer"></i> {{localize "EC.Action.Workshop"}}</button>
    </div>
  </header>

  {{#if hasEncounter}}
    <section class="ec-overview">
      <article class="ec-rating">
        <span>{{localize "EC.Dashboard.Overall"}}</span>
        <strong>{{classification}}</strong>
        <small>{{localize "EC.Dashboard.Score"}} {{score}}</small>
      </article>
      <article class="ec-rating">
        <span>{{localize "EC.Dashboard.Volatility"}}</span>
        <strong>{{volatility}}</strong>
      </article>
      <article class="ec-rating">
        <span>{{localize "EC.Dashboard.Confidence"}}</span>
        <strong>{{confidence}}</strong>
        <small>{{confidencePercent}}</small>
      </article>
    </section>

    {{#if warnings.length}}
      <section class="ec-warnings">
        <h2>{{localize "EC.Dashboard.Warnings"}}</h2>
        <ul>
          {{#each warnings}}
            <li>{{label}}</li>
          {{/each}}
        </ul>
      </section>
    {{/if}}

    <section>
      <h2>{{localize "EC.Dashboard.Models"}}</h2>
      <div class="ec-model-grid">
        {{#each models}}
          <details class="ec-model-card">
            <summary><strong>{{label}}</strong><span>{{classification}}</span><small>{{confidence}}</small></summary>
            <pre>{{metrics}}</pre>
          </details>
        {{/each}}
      </div>
    </section>

    <section class="ec-participants">
      <h2>{{localize "EC.Dashboard.Participants"}}</h2>
      <div class="ec-two-columns">
        <div>
          <h3>{{localize "EC.Side.Party"}}</h3>
          <div class="ec-table-scroll">
            <table>
              <thead><tr><th>{{localize "EC.Field.Name"}}</th><th>{{localize "EC.Field.Quantity"}}</th><th>{{localize "EC.Field.Level"}}</th><th>{{localize "EC.Field.HP"}}</th></tr></thead>
              <tbody>
                {{#each party}}<tr><td>{{name}}</td><td>{{quantity}}</td><td>{{levelOrCr}}</td><td>{{hpText}}</td></tr>{{/each}}
                {{#each allies}}<tr><td>{{name}} <em>({{localize "EC.Side.Ally"}})</em></td><td>{{quantity}}</td><td>{{levelOrCr}}</td><td>{{hpText}}</td></tr>{{/each}}
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <h3>{{localize "EC.Side.Enemies"}}</h3>
          <div class="ec-table-scroll">
            <table>
              <thead><tr><th>{{localize "EC.Field.Name"}}</th><th>{{localize "EC.Field.Quantity"}}</th><th>{{localize "EC.Field.CR"}}</th><th>{{localize "EC.Field.HP"}}</th></tr></thead>
              <tbody>
                {{#each enemies}}<tr><td>{{name}}</td><td>{{quantity}}</td><td>{{levelOrCr}}</td><td>{{hpText}}</td></tr>{{/each}}
                {{#each neutral}}<tr><td>{{name}} <em>({{localize "EC.Side.Neutral"}})</em></td><td>{{quantity}}</td><td>{{levelOrCr}}</td><td>{{hpText}}</td></tr>{{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <footer class="ec-footer-actions">
      {{#if isGM}}
        <button type="button" data-action="ec-post-summary"><i class="fa-solid fa-comment"></i> {{localize "EC.Action.PostSummary"}}</button>
        <button type="button" data-action="ec-save"><i class="fa-solid fa-book"></i> {{localize "EC.Action.Save"}}</button>
        <button type="button" data-action="ec-place"><i class="fa-solid fa-location-dot"></i> {{localize "EC.Action.Place"}}</button>
        <button type="button" data-action="ec-create-combat"><i class="fa-solid fa-swords"></i> {{localize "EC.Action.CreateCombat"}}</button>
      {{/if}}
    </footer>
  {{else}}
    <section class="ec-empty">
      <i class="fa-solid fa-scale-balanced"></i>
      <p>{{localize "EC.Dashboard.EmptyHint"}}</p>
    </section>
  {{/if}}
</div>
